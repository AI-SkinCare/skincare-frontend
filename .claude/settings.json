{
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Edit|Write|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/troubleshoot-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
